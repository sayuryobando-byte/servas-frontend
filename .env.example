# URL base del backend (Spring Boot). Cuando el backend esté listo,
# apunten aquí (ej: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# true  -> usa datos simulados (mocks) sin necesitar el backend levantado
# false -> llama al backend real definido en VITE_API_BASE_URL
VITE_USE_MOCKS=true
